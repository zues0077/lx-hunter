{
  "name": "lx-hunter-pc",
  "version": "1.14.4",
  "description": "音源猎手 PC 版 — GitHub 洛雪音源爬取、沙箱可用性检测、批量灌入自建 LX MUSIC 服务",
  "main": "src/main/index.js",
  "author": "lx-hunter-pc",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "start:web": "node src/server/web.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node tests/tools/run-tests.js",
    "test:dist": "node tests/dist-selfcheck.js",
    "test:sandbox": "node tests/tools/run-tests.js --group=sandbox",
    "test:serial": "node tests/tools/run-tests.js --serial",
    "test:group": "node tests/tools/run-tests.js --group"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lxhunter.pc",
    "productName": "音源猎手PC",
    "icon": "build/icon.ico",
    "files": [
      "src/**/*",
      "package.json",
      "tests/eval-cases/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false,
      "signDlls": false,
      "artifactName": "音源猎手PC-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "音源猎手PC-${version}-${arch}.${ext}"
    }
  }
}
