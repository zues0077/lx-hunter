# 统一换行符为 LF，杜绝 Windows 上 core.autocrlf=true 造成的 CRLF 漂移
# （历史：源码曾以 CRLF 入库，导致 Docker/PC 镜像内源文件为 CRLF，
#  P-1315 记录「哈希对账必须 replace(/\r\n/g,'\n') 归一化」的永久麻烦）

# 文本文件统一 LF
* text=auto eol=lf

# 源码与配置明确锁 LF
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.html  text eol=lf
*.css   text eol=lf

# 二进制文件不做换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.asar  binary
*.7z    binary
*.exe   binary
